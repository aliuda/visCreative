// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Additional runtime files > codebuddy keeps its pre-runtimePaths policy and filtered environment exactly 1`] = `
{
  "env": {
    "CODEBUDDY_API_KEY": "fake",
    "CODEBUDDY_AUTH_TOKEN": "fake",
    "CODEBUDDY_CONFIG_DIR": "<root>/home/.codebuddy",
    "HOME": "<root>/home",
    "PATH": "/usr/bin",
    "SSL_CERT_FILE": "/etc/ssl/cert.pem",
    "TMPDIR": "<root>/data/spaces/own/sessions/work/.vis-tmp",
    "TMPPREFIX": "<root>/data/spaces/own/sessions/work/.vis-tmp/zsh",
  },
  "isolation": "sandbox",
  "notice": undefined,
  "policy": "(version 1)
(allow default)
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd.xpc") (global-name "com.apple.security.agent"))
(deny file-read* (subpath "<root>/data/run") (subpath "<root>/data/providers.json") (subpath "<root>/home/.vis-dev/run") (subpath "<root>/home/.ssh") (subpath "<root>/home/.codex") (subpath "<root>/home/.dsh") (subpath "<root>/home/.claude") (subpath "<root>/home/.claude.json") (subpath "<root>/home/.minimax") (subpath "<root>/home/.mavis") (subpath "<root>/home/.codebuddy.json") (subpath "<root>/home/Library/Keychains") (subpath "/Library/Keychains") (require-all (subpath "<root>/data") (regex #"/app[.]db[^/]*$")) (require-all (subpath "<root>/data/spaces") (regex #"/space[.]db[^/]*$")) (require-all (subpath "<root>/home") (regex #"/[.]claude[.]json[.][^/]*$")) (require-all (subpath "<root>/home") (regex #"/[.]mavis-[^/]*$")) (require-all (subpath "<root>/home") (regex #"/[.]codebuddy[.]json[.][^/]*$")))
(deny file-write*)
(allow file-write* (subpath "<root>/data/spaces/own/sessions/work") (subpath "<root>/home/.codebuddy") (literal "/dev/null") (literal "/dev/tty") (subpath "/dev/fd"))",
}
`;

